# ==========================================
# Telegram & GitHub Actions Converter Config
# ==========================================

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="9189317935:AAHTlKCuX42Use3My-hwyfY9bc5L2NK9G8M"

# 2. Telegram Whitelist (Comma-separated Telegram user IDs allowed to use the bot)
# Obtain your numeric Telegram User ID from @userinfobot
ALLOWED_USER_IDS="123456789,987654321"

# 3. GitHub Repository Configuration
# Your GitHub repo in format: owner/repo
GITHUB_REPO="username/telegram-actions-downloader"

# 4. GitHub Personal Access Token (PAT)
# Needs 'repo' scope or 'actions:write' permission to trigger workflow_dispatch / repository_dispatch
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 5. Telegram MTProto Client Credentials (for GitHub Actions runner to upload up to 2GB)
# Get these free from https://my.telegram.org -> API development tools
TELEGRAM_API_ID="1234567"
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"
